# Build stage: Compile static assets using Node.js
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json tsconfig.json vite.config.ts ./
RUN npm ci || npm install

COPY index.html ./
COPY src/ ./src
RUN npm run build

# Runtime stage: Serve static assets with Nginx
FROM nginx:1.25-alpine AS runtime

# Create unprivileged system user for container security
RUN addgroup -g 10001 -S appgroup && \
    adduser -u 10001 -S appuser -G appgroup

# Set permissions for Nginx runtime directories
RUN touch /var/run/nginx.pid && \
    chown -R appuser:appgroup /var/run/nginx.pid && \
    chown -R appuser:appgroup /var/cache/nginx && \
    chown -R appuser:appgroup /var/log/nginx && \
    chown -R appuser:appgroup /etc/nginx/conf.d

COPY --from=builder --chown=appuser:appgroup /app/dist /usr/share/nginx/html
COPY --chown=appuser:appgroup nginx.conf /etc/nginx/conf.d/default.conf

USER appuser
EXPOSE 80

# Container health check probe for orchestration monitoring
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
